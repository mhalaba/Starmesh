[Unit]
Description=Starmesh hub (Starlink IPv6 overlay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=starmesh
Group=starmesh
Environment=STARMESH_HOME=/var/lib/starmesh
ExecStart=/usr/local/bin/starmesh hub --name "OSP Nadarzyn"
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65535
# QUIC wants a large UDP receive buffer.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
